{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Release)",
            "type": "shell",
            "command": "cmake --build build --config Release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build (Debug)",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -B build",
            "problemMatcher": []
        }
    ]
}
