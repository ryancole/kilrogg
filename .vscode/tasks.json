{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Release)",
            "type": "shell",
            "command": "cmake --build build --config Release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build (Debug)",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -B build",
            "problemMatcher": []
        },
        {
            "label": "local test (dummy source)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File etc/local-test.ps1",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "local test (desktop capture)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File etc/local-test.ps1 -Desktop",
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
